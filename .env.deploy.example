# Copy this file to .env on the deployment VM and replace every change-me value.
POSTGRES_DB=transitops
POSTGRES_USER=transitops
POSTGRES_PASSWORD=change-me-use-a-long-random-database-password
JWT_SIGNING_KEY=change-me-use-at-least-32-random-characters
BOOTSTRAP_TOKEN=change-me-use-a-long-random-bootstrap-token

# Registry holding the published images. Override only if you fork the repository.
IMAGE_REPOSITORY=ghcr.io/pey-45

# latest follows successful main/tag publications. Pin a commit SHA for rollback.
IMAGE_TAG=latest
