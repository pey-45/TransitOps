{
  "Jwt": {
    "Issuer": "TransitOps.Api",
    "Audience": "TransitOps.Frontend",
    "ExpirationMinutes": 60
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
