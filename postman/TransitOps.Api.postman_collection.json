            "body": { "mode": "raw", "raw": "{\n  \"status\": \"in_progress\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/shipments/{{shipmentId}}/status", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "shipments", "{{shipmentId}}", "status" ] },
            "description": "Transiciones permitidas: planned → in_progress/cancelled e in_progress → delivered/cancelled. Los estados finales no se reabren."
          }
