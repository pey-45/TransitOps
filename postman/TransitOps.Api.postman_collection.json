            "description": "Body: licensePlate (requerido, máx 20), internalCode (máx 50), brand (máx 80), model (máx 80), loadCapacity (0.01 a 9999999999.99)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
