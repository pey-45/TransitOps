              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"licensePlate\": \"PMT-{{runId}}-U\",\n  \"internalCode\": \"VEH-{{runId}}-U\",\n  \"brand\": \"Mercedes\",\n  \"model\": \"Actros\",\n  \"loadCapacity\": 12000.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "vehicles", "{{vehicleId}}" ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [ "pm.test(\"Status 200\", () => pm.response.to.have.status(200));" ] }
            }
          ]
        },
        {
          "name": "Dar de Baja Vehículo",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "vehicles", "{{vehicleId}}" ]
            },
            "description": "Baja lógica: marca isActive=false, no elimina físicamente el registro."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [ "pm.test(\"Status 200\", () => pm.response.to.have.status(200));" ] }
            }
          ]
        }
      ]
    },
