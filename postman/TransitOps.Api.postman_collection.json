{
  "info": {
    "name": "TransitOps API",
    "_postman_id": "b3f2a6e0-5b1a-4a2a-9d3a-transitops0001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección de la API de TransitOps (ASP.NET Core, base path /api/v1). Cubre autenticación mediante cookie de mismo origen, catálogos, operación y trazabilidad de envíos, administración de usuarios e indicadores (Sprints 1–7). Todas las respuestas siguen el envoltorio { \"data\": ..., \"requestId\": ... } salvo /health."
  },
  "auth": { "type": "noauth" },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"runId\")) {",
          "  pm.collectionVariables.set(\"runId\", Date.now().toString().slice(-8));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "bootstrapToken", "value": "transitops-bootstrap-local-only", "type": "string" },
    { "key": "bootstrapUsername", "value": "admin", "type": "string" },
    { "key": "bootstrapEmail", "value": "admin@transitops.local", "type": "string" },
    { "key": "bootstrapPassword", "value": "Admin!12345678", "type": "string" },
    { "key": "runId", "value": "", "type": "string" },
    { "key": "vehicleId", "value": "", "type": "string" },
    { "key": "driverId", "value": "", "type": "string" },
    { "key": "customerId", "value": "", "type": "string" },
    { "key": "shipmentId", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "temporaryPassword", "value": "Admin!87654321", "type": "string" },
    { "key": "selfUserId", "value": "", "type": "string" },
    { "key": "resetPassword", "value": "Reset!12345678", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "health" ]
            },
            "description": "Liveness check. Respuesta sin envoltorio: { \"status\": \"healthy\" }."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status healthy\", () => pm.expect(pm.response.json().status).to.eql(\"healthy\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Bootstrap First Admin",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Bootstrap-Token", "value": "{{bootstrapToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{bootstrapUsername}}\",\n  \"email\": \"{{bootstrapEmail}}\",\n  \"password\": \"{{bootstrapPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/bootstrap-admin",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "bootstrap-admin" ]
            },
            "description": "Crea el primer usuario admin del sistema. Requiere el header X-Bootstrap-Token igual a Bootstrap:FirstAdminToken. Solo funciona si aún no existe ningún admin activo (409 first_admin_already_exists en ejecuciones posteriores, lo cual es esperado)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 or already bootstrapped (409)\", () => {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{bootstrapUsername}}\",\n  \"password\": \"{{bootstrapPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "login" ]
            },
            "description": "Autentica, devuelve el usuario y la caducidad en el cuerpo, y establece la cookie HttpOnly transitops_session. Postman conserva la cookie en su jar y la envía automáticamente en las peticiones posteriores."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const payload = pm.response.json();",
                  "pm.test(\"Devuelve usuario y caducidad sin exponer el JWT\", () => {",
                  "  pm.expect(payload.data.user.username).to.eql(pm.variables.get(\"bootstrapUsername\"));",
                  "  pm.expect(payload.data.expiresAt).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(payload.data).not.to.have.property(\"accessToken\");",
                  "});",
                  "pm.collectionVariables.set(\"selfUserId\", payload.data.user.id);",
                  "pm.test(\"Establece la cookie HttpOnly de mismo origen\", () => {",
                  "  const setCookie = (pm.response.headers.get(\"Set-Cookie\") || \"\").toLowerCase();",
                  "  pm.expect(setCookie).to.include(\"transitops_session=\");",
                  "  pm.expect(setCookie).to.include(\"httponly\");",
                  "  pm.expect(setCookie).to.include(\"samesite=strict\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Session",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/session",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "session" ]
            },
            "description": "Requiere la cookie de sesión con policy 'operational' (admin u operator). Devuelve data.username y data.role."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cambiar Contraseña Propia",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{bootstrapPassword}}\",\n  \"newPassword\": \"{{temporaryPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/password",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "password" ]
            },
            "description": "Cambia la contraseña de la cuenta autenticada tras comprobar la actual (RN-14). Esta petición usa una contraseña temporal; restáurala antes de cerrar la sesión."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con Contraseña Temporal",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{bootstrapUsername}}\",\n  \"password\": \"{{temporaryPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "login" ]
            },
            "description": "Renueva la cookie después del cambio de contraseña, que invalida inmediatamente la sesión anterior."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Restaurar Contraseña Propia",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{temporaryPassword}}\",\n  \"newPassword\": \"{{bootstrapPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/password",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "password" ]
            },
            "description": "Restaura la contraseña local después de ejecutar la petición anterior."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Restablecer Sesión Original",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{bootstrapUsername}}\",\n  \"password\": \"{{bootstrapPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "login" ]
            },
            "description": "Obtiene una sesión válida después de restaurar la contraseña original para continuar el recorrido de la colección."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
