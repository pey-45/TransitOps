{
  "info": {
    "name": "TransitOps API",
    "_postman_id": "b3f2a6e0-5b1a-4a2a-9d3a-transitops0001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección de la API de TransitOps (ASP.NET Core, base path /api/v1). Cubre autenticación, catálogos y gestión de envíos con filtros y paginación (Sprints 1–3). Todas las respuestas siguen el envoltorio { \"data\": ..., \"requestId\": ... } salvo /health."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"runId\")) {",
          "  pm.collectionVariables.set(\"runId\", Date.now().toString().slice(-8));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "bootstrapToken", "value": "transitops-bootstrap-local-only", "type": "string" },
    { "key": "bootstrapUsername", "value": "admin", "type": "string" },
    { "key": "bootstrapEmail", "value": "admin@transitops.local", "type": "string" },
    { "key": "bootstrapPassword", "value": "Admin!12345678", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "runId", "value": "", "type": "string" },
    { "key": "vehicleId", "value": "", "type": "string" },
    { "key": "driverId", "value": "", "type": "string" },
    { "key": "customerId", "value": "", "type": "string" },
    { "key": "shipmentId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "health" ]
            },
            "description": "Liveness check. Respuesta sin envoltorio: { \"status\": \"healthy\" }."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status healthy\", () => pm.expect(pm.response.json().status).to.eql(\"healthy\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Bootstrap First Admin",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Bootstrap-Token", "value": "{{bootstrapToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{bootstrapUsername}}\",\n  \"email\": \"{{bootstrapEmail}}\",\n  \"password\": \"{{bootstrapPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/bootstrap-admin",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "bootstrap-admin" ]
            },
            "description": "Crea el primer usuario admin del sistema. Requiere el header X-Bootstrap-Token igual a Bootstrap:FirstAdminToken. Solo funciona si aún no existe ningún admin activo (409 first_admin_already_exists en ejecuciones posteriores, lo cual es esperado)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 or already bootstrapped (409)\", () => {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{bootstrapUsername}}\",\n  \"password\": \"{{bootstrapPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "login" ]
            },
            "description": "Autentica y devuelve un JWT en data.accessToken. Se guarda automáticamente en la variable de colección accessToken para el resto de peticiones (Authorization: Bearer {{accessToken}})."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const payload = pm.response.json();",
                  "pm.test(\"Devuelve accessToken Bearer\", () => {",
                  "  pm.expect(payload.data.tokenType).to.eql(\"Bearer\");",
                  "  pm.expect(payload.data.accessToken).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.collectionVariables.set(\"accessToken\", payload.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Session",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/session",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "session" ]
            },
            "description": "Requiere Bearer con policy 'operational' (admin u operator). Devuelve data.username y data.role."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin Check",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/admin-check",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "admin-check" ]
            },
            "description": "Requiere Bearer con policy 'admin' (solo rol admin). Devuelve data.authorized = true. Con un token de operator debería devolver 403 authorization_forbidden."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
