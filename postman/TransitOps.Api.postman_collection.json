    {
      "name": "Envíos",
      "item": [
        {
          "name": "Listar Envíos con Filtros",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/shipments?status=planned&pickupFrom=2026-08-01&pickupTo=2026-08-31&page=1&pageSize=20",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "shipments" ],
              "query": [
                { "key": "status", "value": "planned" },
                { "key": "pickupFrom", "value": "2026-08-01" },
                { "key": "pickupTo", "value": "2026-08-31" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Crear Envío",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"reference\": \"ENV-{{runId}}\",\n  \"origin\": \"A Coruña\",\n  \"destination\": \"Madrid\",\n  \"plannedPickupAt\": \"2026-08-01T08:00:00Z\",\n  \"plannedDeliveryAt\": \"2026-08-01T18:00:00Z\",\n  \"estimatedLoad\": 1500.00,\n  \"notes\": \"Creado desde Postman\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/shipments", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "shipments" ] }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test(\"Status 201\", () => pm.response.to.have.status(201));", "pm.collectionVariables.set(\"shipmentId\", pm.response.json().data.id);" ] } } ]
        },
        {
          "name": "Obtener Envío por Id",
          "request": { "method": "GET", "header": [ { "key": "Accept", "value": "application/json" } ], "url": { "raw": "{{baseUrl}}/api/v1/shipments/{{shipmentId}}", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "shipments", "{{shipmentId}}" ] } }
        },
        {
          "name": "Actualizar Envío",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"reference\": \"ENV-{{runId}}\",\n  \"origin\": \"A Coruña\",\n  \"destination\": \"Barcelona\",\n  \"plannedPickupAt\": \"2026-08-01T08:00:00Z\",\n  \"plannedDeliveryAt\": \"2026-08-01T20:00:00Z\",\n  \"estimatedLoad\": 1600.00,\n  \"notes\": \"Actualizado desde Postman\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/shipments/{{shipmentId}}", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "shipments", "{{shipmentId}}" ] }
          }
        }
      ]
    },
