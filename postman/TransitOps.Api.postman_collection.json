          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/api/v1/shipments/{{shipmentId}}/events", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "shipments", "{{shipmentId}}", "events" ] },
            "description": "Devuelve el historial inmutable completo, ordenado por occurredAt y createdAt, con el usuario que registró cada evento. Incluye las trazas automáticas de creación, asignación y ciclo de estado."
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test(\"Status 200\", () => pm.response.to.have.status(200));" ] } } ]
        },
        {
          "name": "Registrar evento",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"eventType\": \"checkpoint\",\n  \"occurredAt\": \"2026-07-31T08:00:00Z\",\n  \"location\": \"Punto de control A-6\",\n  \"notes\": \"Paso sin incidencias\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/shipments/{{shipmentId}}/events", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "shipments", "{{shipmentId}}", "events" ] },
            "description": "Registra un evento manual asociado al usuario del token. Solo se admiten eventType=checkpoint o eventType=incident: creación, asignación y cambios de estado están reservados al sistema para impedir que el cliente falsee la traza. occurredAt es opcional y, si se omite, se usa la hora actual."
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test(\"Status 201\", () => pm.response.to.have.status(201));" ] } } ]
        }
